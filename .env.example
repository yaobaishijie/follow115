# Application
APP_HOST=0.0.0.0
APP_PORT=3000
WEB_PORT=8080
APP_LOG_LEVEL=info
SESSION_SECRET=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Database
POSTGRES_DB=follow115
POSTGRES_USER=follow115
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://follow115:replace-with-a-strong-password@postgres:5432/follow115

# Initial single-user login. The password is never returned by the API.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# External service configuration. 代理策略由产品设置页保存，首次默认使用
# HTTP://clash:7890；此目录沿用现有 Mihomo/Clash 配置。
PAN115_BASE_URL=https://webapi.115.com
TMDB_API_TOKEN=
CLASH_CONFIG_DIR=/Volumes/sansung/docker/cloudsaver/clash
